			"brace-expansion@2": "^2.1.3",
			"cookie@<0.7.0": "^0.7.0",
			"devalue": "^5.6.4",
			"esbuild@<0.25.0": "^0.25.0",
			"flatted": "^3.4.2",
			"glob@10": "^10.5.0",
			"js-yaml@4": "^4.3.1",
			"minimatch@3": "^3.1.4",
			"minimatch@9": "^9.0.7",
